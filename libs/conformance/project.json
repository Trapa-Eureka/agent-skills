{
  "name": "conformance",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/conformance/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/conformance",
        "main": "libs/conformance/src/index.ts",
        "tsConfig": "libs/conformance/tsconfig.lib.json",
        "assets": ["libs/conformance/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": { "jestConfig": "libs/conformance/jest.config.ts" }
    }
  }
}
